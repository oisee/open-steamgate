<mvc:View controllerName="stg.workbench.controller.App" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
  xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:wb="stg.workbench.control" displayBlock="true" height="100%">
  <Page id="page" showHeader="true" busy="{ui>/busy}" busyIndicatorDelay="0">
    <customHeader><OverflowToolbar>
      <Title text="Workbench" level="H2"/>
      <Select id="objectType" width="13rem" selectedKey="{ui>/objectType}" change=".onObjectTypeChange" items="{ui>/objectTypes}" tooltip="Repository object type">
        <core:Item key="{ui>key}" text="{ui>text}"/>
      </Select>
      <ToolbarSpacer/>
      <Button id="discard" text="Discard edits" icon="sap-icon://undo" press=".onDiscard" enabled="{= !!${ui>/selected/name} &amp;&amp; ${ui>/dirty}}"/>
      <Button id="check" text="Check" icon="sap-icon://validate" press=".onCheck" enabled="{= !!${ui>/selected/name}}"/>
      <Button id="save" text="Save inactive" icon="sap-icon://save" press=".onSave" enabled="{= !!${ui>/selected/name} &amp;&amp; ${ui>/dirty}}"/>
      <Button id="activate" text="Activate" icon="sap-icon://activate" type="Emphasized" press=".onActivate" enabled="{= !!${ui>/selected/name}}"/>
    </OverflowToolbar></customHeader>
    <content><l:Splitter id="splitter" height="100%">
      <VBox class="sapUiSmallMargin" height="100%">
        <layoutData><l:SplitterLayoutData size="25%" minSize="240"/></layoutData>
        <SearchField id="search" width="100%" value="{ui>/query}" search=".onSearch" liveChange=".onSearchLive" placeholder="Name pattern, e.g. Z*"/>
        <List id="objects" items="{ui>/objects}" mode="SingleSelectMaster" selectionChange=".onObjectSelect" growing="true" noDataText="No objects found">
          <StandardListItem title="{ui>name}" description="{ui>description}" info="{ui>packageName}" icon="sap-icon://syntax"/>
        </List>
      </VBox>
      <VBox height="100%" fitContainer="true">
        <OverflowToolbar>
          <Title text="{ui>/selected/name}" level="H3"/>
          <ObjectStatus text="{= ${ui>/dirty} ? 'Modified' : 'Saved'}" state="{= ${ui>/dirty} ? 'Warning' : 'Success'}"/>
          <ToolbarSpacer/>
          <ObjectStatus title="Git" text="{ui>/identity/commit}"/>
          <ObjectStatus title="Source" text="{ui>/identity/source}"/>
          <ObjectStatus title="Live" text="{ui>/identity/live}"/>
          <ObjectStatus title="Serving" text="{ui>/identity/serving}" state="{= ${ui>/identity/synchronized} ? 'Success' : 'Warning'}"/>
        </OverflowToolbar>
        <MessageStrip id="message" text="{ui>/message/text}" type="{ui>/message/type}" showIcon="true" visible="{= !!${ui>/message/text}}"/>
        <wb:AbapEditor id="source" type="{ui>/editorMode}" value="{path: &apos;ui>/source&apos;, mode: &apos;OneWay&apos;}" height="100%" width="100%"
          editable="{= !!${ui>/selected/name}}" liveChange=".onSourceChange">
          <wb:layoutData><FlexItemData growFactor="1" baseSize="0"/></wb:layoutData>
        </wb:AbapEditor>
        <Panel id="gitPanel" expandable="true" expanded="false" visible="{= !!${ui>/selected/name}}" busy="{ui>/git/loading}">
          <headerToolbar><OverflowToolbar>
            <Title text="Git history" level="H4"/>
            <ObjectStatus title="Branch" text="{ui>/git/branch}"/>
            <ObjectStatus title="HEAD" text="{ui>/git/headShort}"/>
            <ObjectStatus text="{ui>/git/status}" state="{= ${ui>/git/status} === 'clean' ? 'Success' : ${ui>/git/status} === 'modified' ? 'Warning' : 'Information'}"/>
            <ToolbarSpacer/>
            <Button text="Refresh" icon="sap-icon://refresh" press=".onGitRefresh"/>
          </OverflowToolbar></headerToolbar>
          <content>
            <MessageStrip text="{ui>/git/reason}" type="Information" showIcon="true" visible="{= !${ui>/git/available}}"/>
            <Label text="Stored inactive source vs HEAD · {ui>/git/file}" visible="{ui>/git/available}"/>
            <TextArea value="{ui>/git/diff}" editable="false" rows="8" width="100%" wrapping="None" visible="{= !!${ui>/git/diff}}"/>
            <Text text="Stored source matches HEAD." visible="{= ${ui>/git/available} &amp;&amp; !${ui>/git/diff}}"/>
          </content>
        </Panel>
        <Table id="problems" items="{ui>/diagnostics}" visible="{= ${ui>/diagnostics}.length > 0}"
          mode="SingleSelectMaster" selectionChange=".onProblemSelect" sticky="ColumnHeaders">
          <headerToolbar><Toolbar><Title text="Problems ({= ${ui>/diagnostics}.length})" level="H4"/></Toolbar></headerToolbar>
          <columns><Column width="5rem"><Text text="Line"/></Column><Column width="5rem"><Text text="Col"/></Column><Column><Text text="Message"/></Column></columns>
          <items><ColumnListItem><cells><Text text="{ui>line}"/><Text text="{ui>column}"/><Text text="{ui>message}"/></cells></ColumnListItem></items>
        </Table>
      </VBox>
    </l:Splitter></content>
  </Page>
</mvc:View>
