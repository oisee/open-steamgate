{
  "name": "open-steamgate",
  "version": "0.0.1",
  "description": "Local /IWBEP/ OData v2 runtime for classic code-based SEGW services: transpile ABAP, Open SQL over SQLite, serve Fiori",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "abaplint",
    "transpile": "rm -rf output && node tools/cds2ddic.mjs && abap_transpile",
    "unit": "npm run transpile && echo RUNNING && node --expose-gc output/index.mjs && echo OK",
    "integration": "mocha test/mocha.mjs",
    "test": "npm run lint && npm run unit && npm run integration",
    "start": "npm run transpile && node test/run.mjs",
    "probe": "node tools/closure-probe.mjs",
    "e2e": "npm run transpile && playwright test",
    "e2e:install": "playwright install chromium",
    "cds": "node tools/cds2ddic.mjs"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.48",
    "@abaplint/core": "^2.120.48",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/runtime": "^2.13.85",
    "@abaplint/transpiler-cli": "^2.13.85",
    "@playwright/test": "^1.62.1",
    "chai": "^5.3.3",
    "express": "^4.22.2",
    "mocha": "^11.7.6"
  }
}
