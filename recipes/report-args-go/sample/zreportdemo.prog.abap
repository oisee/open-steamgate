REPORT zreportdemo.
CONSTANTS gc_def TYPE c LENGTH 4 VALUE 'ABCD'.
DATA gv_date TYPE d.
PARAMETERS p_name TYPE c LENGTH 12 DEFAULT 'world' OBLIGATORY.
PARAMETERS p_loud AS CHECKBOX.
SELECT-OPTIONS s_tag FOR p_name DEFAULT 'alpha' TO 'omega' OPTION NE SIGN E.
SELECT-OPTIONS s_when FOR gv_date DEFAULT sy-datum TO sy-datum.
PARAMETERS p_in RADIOBUTTON GROUP dir DEFAULT 'X'.
PARAMETERS p_out RADIOBUTTON GROUP dir.
PARAMETERS p_date TYPE d DEFAULT sy-datum.
PARAMETERS p_const TYPE c LENGTH 4 DEFAULT gc_def.
PARAMETERS p_plain.
START-OF-SELECTION.
  WRITE p_name.
