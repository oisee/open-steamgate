REPORT {{report}}.
* Generated by tools/dsl-l3.mjs from {{source}}; do not edit.
* Set {{set}}: one rule of the set as one background job step,
* submitted by {{class}}=>run( iv_mode = 'P' ).
{{#planned}}
* One pile of the rule: the job reads its range from the plan row
* ZOSD_L3_PILE (set, p_run, p_rule, p_pile), not from a selection field.
{{/planned}}
{{#staged}}
* A pile that ends DONE commits, then asks the gate: the job that finds
* every pile of its stage DONE opens the next stage (advance).
{{/staged}}
{{#schedule}}
* p_mode = 'D' is the driver of the schedule: one run of the set in jobs
* for the current date; 'R' (the default) runs one rule's pile.
{{#resilience}}
* p_mode = 'H' is the doctor's job: one pass of the doctor over the set.
{{/resilience}}
{{/schedule}}
{{#resilience}}
* A pile the kill switch sent back, or one past the fuse, commits its row
* and ends the job without aborting it.
{{/resilience}}

PARAMETERS p_rule TYPE c LENGTH 60 LOWER CASE.
PARAMETERS p_date TYPE d.
PARAMETERS p_run TYPE c LENGTH 32.
{{#planned}}
PARAMETERS p_pile TYPE i.
{{/planned}}
PARAMETERS p_bind TYPE c LENGTH 255 LOWER CASE.
{{#settings.entries}}
{{^unscreened}}
PARAMETERS {{screen}} TYPE c LENGTH 40 LOWER CASE.
{{/unscreened}}
{{/settings.entries}}
{{#params}}
{{#is_selopt}}
DATA {{sel}} TYPE {{type_name}}.
SELECT-OPTIONS {{screen}} FOR {{sel}}.
{{/is_selopt}}
{{^is_selopt}}
PARAMETERS {{screen}} TYPE {{type_name}}.
{{/is_selopt}}
{{/params}}
{{#schedule}}
PARAMETERS p_mode TYPE c LENGTH 1 DEFAULT 'R'.
{{/schedule}}

START-OF-SELECTION.
  DATA ls_rule TYPE {{class}}=>ty_rule.
  DATA lv_bind TYPE string.
{{#settings}}
  DATA ls_settings TYPE {{settings.class}}=>ty_values.
{{#entries}}
{{^unscreened}}
  ls_settings-{{field}} = {{screen}}.
{{/unscreened}}
{{/entries}}
{{/settings}}
{{#with_params}}
  DATA ls_params TYPE {{class}}=>ty_params.
{{/with_params}}
{{#schedule}}
  DATA ls_result TYPE {{class}}=>ty_result.
  DATA ls_deleted TYPE {{class}}=>ty_unschedule.
  IF p_mode = 'U'.
    ls_deleted = {{class}}=>unschedule( ).
    WRITE: / 'deleted', ls_deleted-deleted, 'refused', ls_deleted-refused.
    RETURN.
  ENDIF.
  IF p_mode = 'D'.
    " the date of the moment the instance starts, not of when it was planned
    GET TIME.
    ls_result = {{class}}=>run( iv_date = sy-datum iv_mode = {{class}}=>c_parallel ).
    WRITE: / ls_result-run_id, ls_result-status.
    RETURN.
  ENDIF.
{{#resilience}}
  DATA lt_report TYPE {{class}}=>tt_doctor.
  DATA lv_actions TYPE i.
  IF p_mode = 'H'.
    " the doctor: one pass over the set's open runs, then purge
    lt_report = {{class}}=>doctor( ).
    lv_actions = lines( lt_report ).
    WRITE: / 'doctor', lv_actions.
{{#autodoctor}}
{{#release_event}}
    " then the release: the claims are committed before their events are raised
    DATA lt_released_h TYPE {{class}}=>tt_pile.
    COMMIT WORK.
    lt_released_h = {{class}}=>release_claim( ).
    COMMIT WORK.
    {{class}}=>release_raise( lt_released_h ).
    COMMIT WORK.
{{/release_event}}
{{/autodoctor}}
    RETURN.
  ENDIF.
{{/resilience}}
{{/schedule}}
{{#params}}
  ls_params-{{name}} = {{screen}}{{#is_selopt}}[]{{/is_selopt}}.
{{/params}}
  lv_bind = p_bind.
  ls_rule = {{class}}=>run_rule(
    iv_rule = p_rule
    iv_date = p_date
    iv_run = p_run
{{#settings}}
    is_settings = ls_settings
{{/settings}}
{{#planned}}
    iv_pile = p_pile
{{/planned}}
{{#with_params}}
    is_params = ls_params
{{/with_params}}
    iv_bind = lv_bind ).
  WRITE: / ls_rule-rule, ls_rule-status, ls_rule-alerts.
{{#resilience}}
  IF ls_rule-status = 'KILLED' OR ls_rule-status = 'FUSED'.
    " the pile row says so; it is committed and the job ends without abort
    COMMIT WORK.
    RETURN.
  ENDIF.
{{/resilience}}
{{#staged}}
  IF ls_rule-status = 'DONE'.
    " the pile's DONE is committed first, so the gate sees it
    COMMIT WORK.
    {{class}}=>advance( iv_run = p_run
      iv_date = p_date
      iv_stage = ls_rule-stage_no
{{#with_params}}
      is_params = ls_params
{{/with_params}}
      iv_bind = lv_bind ).
  ENDIF.
{{/staged}}
  IF ls_rule-status <> 'DONE'.
    MESSAGE 'The rule did not run to the end; see the list' TYPE 'E'.
  ENDIF.
