REPORT {{report}}.
* Generated by tools/dsl-l3.mjs from {{source}}; do not edit.
* Set {{set}}: one rule of the set as one background job step,
* submitted by {{class}}=>run( iv_mode = 'P' ).
{{#piles}}
* One pile of the rule: the job reads its range from the plan row
* ZOSD_L3_PILE (set, p_run, p_rule, p_pile), not from a selection field.
{{/piles}}

PARAMETERS p_rule TYPE c LENGTH 60 LOWER CASE.
PARAMETERS p_date TYPE d.
PARAMETERS p_run TYPE c LENGTH 32.
{{#piles}}
PARAMETERS p_pile TYPE i.
{{/piles}}
PARAMETERS p_bind TYPE c LENGTH 255 LOWER CASE.
{{#params}}
PARAMETERS {{screen}} TYPE {{type_name}}.
{{/params}}

START-OF-SELECTION.
  DATA ls_rule TYPE {{class}}=>ty_rule.
  DATA lv_bind TYPE string.
{{#with_params}}
  DATA ls_params TYPE {{class}}=>ty_params.
{{/with_params}}
{{#params}}
  ls_params-{{name}} = {{screen}}.
{{/params}}
  lv_bind = p_bind.
  ls_rule = {{class}}=>run_rule(
    iv_rule = p_rule
    iv_date = p_date
    iv_run = p_run
{{#piles}}
    iv_pile = p_pile
{{/piles}}
{{#with_params}}
    is_params = ls_params
{{/with_params}}
    iv_bind = lv_bind ).
  WRITE: / ls_rule-rule, ls_rule-status, ls_rule-alerts.
  IF ls_rule-status <> 'DONE'.
    MESSAGE 'The rule did not run to the end; see the list' TYPE 'E'.
  ENDIF.
