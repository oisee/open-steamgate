  METHOD submit.
    " one job per rule: JOB_OPEN, SUBMIT ... VIA JOB, JOB_CLOSE started at
    " once; the rules do not depend on each other, so no job waits for one
    DATA lv_jobname TYPE tbtcjob-jobname.
