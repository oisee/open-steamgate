* Fixtures: the text of the 2026-09-30 X2 probe (500 times "line n of the probe;",
* UTF-8, 10892 bytes). DYN_HEX is its raw DEFLATE as zlib writes it by
* default, 1145 bytes starting 75DA4BAA -- the same length and the same first
* bytes CL_ABAP_GZIP=>COMPRESS_BINARY gave on a 7.5x system; FIX_HEX is the
* same text in fixed-Huffman blocks. Stored blocks are built by hand below.
CLASS ltcl_inflate DEFINITION FOR TESTING DURATION SHORT RISK LEVEL HARMLESS FINAL.
  PRIVATE SECTION.
    METHODS whole_dynamic FOR TESTING RAISING cx_static_check.
    METHODS pieces_dynamic FOR TESTING RAISING cx_static_check.
    METHODS pieces_fixed FOR TESTING RAISING cx_static_check.
    METHODS stored_blocks FOR TESTING RAISING cx_static_check.
    METHODS truncated FOR TESTING RAISING cx_static_check.
    METHODS block_type_3 FOR TESTING RAISING cx_static_check.
    METHODS too_far_back FOR TESTING RAISING cx_static_check.
    METHODS unused_after_end FOR TESTING RAISING cx_static_check.
    METHODS text RETURNING VALUE(rv_raw) TYPE xstring.
    METHODS in_pieces
      IMPORTING iv_data       TYPE xstring
                iv_piece      TYPE i
      RETURNING VALUE(rv_raw) TYPE xstring
      RAISING   zcx_osd_inflate.
    METHODS dyn_hex RETURNING VALUE(rv_data) TYPE xstring.
    METHODS fix_hex RETURNING VALUE(rv_data) TYPE xstring.
ENDCLASS.

CLASS ltcl_inflate IMPLEMENTATION.
  METHOD text.
    DATA lv_text TYPE string.
    DATA lv_n TYPE string.
    DO 500 TIMES.
      lv_n = sy-index.
      CONDENSE lv_n.
      CONCATENATE lv_text 'line ' lv_n ' of the probe;' INTO lv_text RESPECTING BLANKS.
    ENDDO.
    rv_raw = cl_abap_codepage=>convert_to( lv_text ).
  ENDMETHOD.

  METHOD in_pieces.
    DATA lo_inflate TYPE REF TO zcl_osd_inflate.
    DATA lv_pos TYPE i.
    DATA lv_len TYPE i.
    DATA lv_piece TYPE xstring.
    DATA lv_out TYPE xstring.
    CREATE OBJECT lo_inflate.
    WHILE lv_pos < xstrlen( iv_data ).
      lv_len = xstrlen( iv_data ) - lv_pos.
      IF lv_len > iv_piece.
        lv_len = iv_piece.
      ENDIF.
      lv_piece = iv_data+lv_pos(lv_len).
      lv_out = lo_inflate->feed( lv_piece ).
      CONCATENATE rv_raw lv_out INTO rv_raw IN BYTE MODE.
      lv_pos = lv_pos + lv_len.
    ENDWHILE.
    lo_inflate->finish( ).
  ENDMETHOD.

  METHOD whole_dynamic.
    cl_abap_unit_assert=>assert_equals( act = xstrlen( dyn_hex( ) ) exp = 1145 ).
    cl_abap_unit_assert=>assert_equals( act = zcl_osd_inflate=>inflate( dyn_hex( ) ) exp = text( ) ).
  ENDMETHOD.

  METHOD pieces_dynamic.
    cl_abap_unit_assert=>assert_equals( act = in_pieces( iv_data = dyn_hex( ) iv_piece = 1 ) exp = text( ) ).
    cl_abap_unit_assert=>assert_equals( act = in_pieces( iv_data = dyn_hex( ) iv_piece = 7 ) exp = text( ) ).
    cl_abap_unit_assert=>assert_equals( act = in_pieces( iv_data = dyn_hex( ) iv_piece = 100 ) exp = text( ) ).
  ENDMETHOD.

  METHOD pieces_fixed.
    cl_abap_unit_assert=>assert_equals( act = zcl_osd_inflate=>inflate( fix_hex( ) ) exp = text( ) ).
    cl_abap_unit_assert=>assert_equals( act = in_pieces( iv_data = fix_hex( ) iv_piece = 13 ) exp = text( ) ).
  ENDMETHOD.

  METHOD stored_blocks.
* block 1: not final, stored, LEN 3 / NLEN FFFC, "abc"; block 2: final,
* stored, LEN 0; the header byte is 00 (BFINAL 0, BTYPE 00) and 01.
    DATA lv_data TYPE xstring.
    DATA lv_raw TYPE xstring.
    lv_data = '000300FCFF616263010000FFFF'.
    lv_raw = '616263'.
    cl_abap_unit_assert=>assert_equals( act = in_pieces( iv_data = lv_data iv_piece = 1 ) exp = lv_raw ).
    cl_abap_unit_assert=>assert_equals( act = in_pieces( iv_data = lv_data iv_piece = 5 ) exp = lv_raw ).
  ENDMETHOD.

  METHOD truncated.
* the measured difference to CL_ABAP_UNGZIP_BINARY_STREAM: half a stream
* gives the output it completes and then an error, not a silent short result
    DATA lo_inflate TYPE REF TO zcl_osd_inflate.
    DATA lv_half TYPE xstring.
    DATA lv_out TYPE xstring.
    lv_half = dyn_hex( ).
    lv_half = lv_half(572).
    CREATE OBJECT lo_inflate.
    lv_out = lo_inflate->feed( lv_half ).
    cl_abap_unit_assert=>assert_true( boolc( xstrlen( lv_out ) > 0 AND xstrlen( lv_out ) < 10892 ) ).
    cl_abap_unit_assert=>assert_false( lo_inflate->is_done( ) ).
    TRY.
        lo_inflate->finish( ).
        cl_abap_unit_assert=>fail( 'an incomplete stream must not finish' ).
      CATCH zcx_osd_inflate.
    ENDTRY.
  ENDMETHOD.

  METHOD block_type_3.
    DATA lv_data TYPE xstring.
    lv_data = '07'.
    TRY.
        zcl_osd_inflate=>inflate( lv_data ).
        cl_abap_unit_assert=>fail( 'block type 3 must be refused' ).
      CATCH zcx_osd_inflate.
    ENDTRY.
  ENDMETHOD.

  METHOD too_far_back.
* a fixed block whose first symbol copies 3 bytes from distance 1, before
* any output (zlib: "invalid distance too far back")
    DATA lv_data TYPE xstring.
    DATA lx_error TYPE REF TO zcx_osd_inflate.
    lv_data = '030200'.
    TRY.
        zcl_osd_inflate=>inflate( lv_data ).
        cl_abap_unit_assert=>fail( 'a distance before the output must be refused' ).
      CATCH zcx_osd_inflate INTO lx_error.
        cl_abap_unit_assert=>assert_equals( act = lx_error->reason exp = `invalid distance too far back` ).
    ENDTRY.
  ENDMETHOD.

  METHOD unused_after_end.
    DATA lo_inflate TYPE REF TO zcl_osd_inflate.
    DATA lv_data TYPE xstring.
    DATA lv_tail TYPE xstring.
    DATA lv_out TYPE xstring.
    lv_tail = 'DEADBEEF'.
    lv_data = dyn_hex( ).
    CONCATENATE lv_data lv_tail INTO lv_data IN BYTE MODE.
    CREATE OBJECT lo_inflate.
    lv_out = lo_inflate->feed( lv_data ).
    lv_tail = 'CAFE'.
    lo_inflate->feed( lv_tail ).
    lo_inflate->finish( ).
    cl_abap_unit_assert=>assert_equals( act = lv_out exp = text( ) ).
    cl_abap_unit_assert=>assert_true( lo_inflate->is_done( ) ).
    lv_tail = 'DEADBEEFCAFE'.
    cl_abap_unit_assert=>assert_equals( act = lo_inflate->get_unused( ) exp = lv_tail ).
  ENDMETHOD.

