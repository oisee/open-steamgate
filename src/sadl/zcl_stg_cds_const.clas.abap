CLASS zcl_stg_cds_const DEFINITION PUBLIC FINAL CREATE PUBLIC.
* R11 (docs/rap-runtime.md, "Constant elements"): a CDS element that is a
* literal (`1 as CarrierSingletonID`) has no column. The classes that read a
* view with one (generated by tools/cds2ddic.mjs, tools/cds-computed.mjs)
* ask this class two things: what a condition says about the constants
* before the SELECT, and the values to put into each row after it.
  PUBLIC SECTION.
    TYPES:
      BEGIN OF ty_const,
        name  TYPE string,
        value TYPE string,
      END OF ty_const,
      tt_const TYPE STANDARD TABLE OF ty_const WITH DEFAULT KEY.

* CV_WHERE, a dynamic condition: each conjunct at its top level that
* compares a constant with a literal (`NAME = '1'`, `NAME = 1`, the operands
* either way round) is decided here and taken out. RV_MATCH is false when
* one of them is false: then no row matches, whatever the rest says. A
* constant named in any other way (inside OR, another operator) is a
* condition this cannot decide, and is refused rather than sent to a SELECT
* whose view has no such column.
    CLASS-METHODS decide
      IMPORTING
        it_const        TYPE tt_const
      CHANGING
        cv_where        TYPE string
      RETURNING
        VALUE(rv_match) TYPE abap_bool.

* the constants into a row of the view (components by name)
    CLASS-METHODS fill
      IMPORTING
        it_const TYPE tt_const
      CHANGING
        cs_row   TYPE any.

  PRIVATE SECTION.
    CLASS-METHODS conjuncts
      IMPORTING
        iv_where        TYPE string
      RETURNING
        VALUE(rt_parts) TYPE string_table.
    CLASS-METHODS unquote
      IMPORTING
        iv_text         TYPE string
      RETURNING
        VALUE(rv_value) TYPE string.
    CLASS-METHODS same
      IMPORTING
        iv_left       TYPE string
        iv_right      TYPE string
      RETURNING
        VALUE(rv_yes) TYPE abap_bool.
ENDCLASS.

CLASS zcl_stg_cds_const IMPLEMENTATION.

  METHOD decide.
    DATA lt_parts TYPE string_table.
    DATA lv_part  TYPE string.
    DATA lv_upper TYPE string.
    DATA lv_left  TYPE string.
    DATA lv_right TYPE string.
    DATA lv_rest  TYPE string.
    DATA ls_const TYPE ty_const.
    DATA lv_named TYPE abap_bool.
    DATA lv_done  TYPE abap_bool.
    DATA lv_value TYPE string.
    DATA lv_pat   TYPE string.

    rv_match = abap_true.
    IF it_const IS INITIAL OR cv_where IS INITIAL.
      RETURN.
    ENDIF.
    lt_parts = conjuncts( cv_where ).
    LOOP AT lt_parts INTO lv_part.
      lv_upper = to_upper( condense( lv_part ) ).
      lv_done = abap_false.
      LOOP AT it_const INTO ls_const.
        lv_pat = |\\b{ to_upper( ls_const-name ) }\\b|.
        FIND REGEX lv_pat IN lv_upper.
        IF sy-subrc <> 0.
          CONTINUE.
        ENDIF.
* NAME = literal, or literal = NAME, and nothing else
        CLEAR: lv_left, lv_right.
        SPLIT lv_part AT '=' INTO lv_left lv_right lv_rest.
        lv_left = to_upper( condense( lv_left ) ).
        lv_right = condense( lv_right ).
        lv_named = abap_false.
        IF lv_rest IS INITIAL AND lv_left = to_upper( ls_const-name ).
          lv_value = lv_right.
          lv_named = abap_true.
        ELSEIF lv_rest IS INITIAL AND to_upper( lv_right ) = to_upper( ls_const-name ).
          lv_value = lv_left.
          lv_named = abap_true.
        ENDIF.
        IF lv_named = abap_false OR lv_value CA '<>!()' OR to_upper( lv_value ) CS ' OR '.
          RAISE EXCEPTION TYPE /iwbep/cx_mgw_not_impl_exc
            EXPORTING
              textid = /iwbep/cx_mgw_not_impl_exc=>method_not_implemented
              method = |a condition on the constant element { ls_const-name } other than = a literal: { lv_part }|.
        ENDIF.
        IF same( iv_left = unquote( lv_value ) iv_right = ls_const-value ) = abap_false.
          rv_match = abap_false.
        ENDIF.
        lv_done = abap_true.
        EXIT.
      ENDLOOP.
      IF lv_done = abap_true.
        DELETE lt_parts.
      ENDIF.
    ENDLOOP.
    CLEAR cv_where.
    LOOP AT lt_parts INTO lv_part.
      IF cv_where IS NOT INITIAL.
        cv_where = cv_where && ` AND `.
      ENDIF.
      cv_where = cv_where && lv_part.
    ENDLOOP.
  ENDMETHOD.

  METHOD fill.
    DATA ls_const TYPE ty_const.
    FIELD-SYMBOLS <lv_value> TYPE any.
    LOOP AT it_const INTO ls_const.
      ASSIGN COMPONENT ls_const-name OF STRUCTURE cs_row TO <lv_value>.
      IF sy-subrc = 0.
        <lv_value> = ls_const-value.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD conjuncts.
* split at AND on the top level: not inside quotes, not inside parentheses
    DATA lv_len   TYPE i.
    DATA lv_pos   TYPE i.
    DATA lv_depth TYPE i.
    DATA lv_quote TYPE abap_bool.
    DATA lv_start TYPE i.
* a string: a blank is ` `, which a C field of length 1 compared with a
* string is not (its trailing blank goes)
    DATA lv_char  TYPE string.
    DATA lv_next  TYPE string.
    DATA lv_part  TYPE string.
    DATA lv_take  TYPE i.

    lv_len = strlen( iv_where ).
    WHILE lv_pos < lv_len.
      lv_char = iv_where+lv_pos(1).
      IF lv_char = `'`.
        IF lv_quote = abap_true.
          lv_quote = abap_false.
        ELSE.
          lv_quote = abap_true.
        ENDIF.
      ELSEIF lv_quote = abap_false AND lv_char = '('.
        lv_depth = lv_depth + 1.
      ELSEIF lv_quote = abap_false AND lv_char = ')'.
        lv_depth = lv_depth - 1.
      ELSEIF lv_quote = abap_false AND lv_depth = 0 AND lv_char = ` ` AND lv_pos + 5 <= lv_len.
        lv_next = to_upper( iv_where+lv_pos(5) ).
        IF lv_next = ` AND `.
          lv_take = lv_pos - lv_start.
          lv_part = iv_where+lv_start(lv_take).
          lv_part = condense( lv_part ).
          IF lv_part IS NOT INITIAL.
            APPEND lv_part TO rt_parts.
          ENDIF.
          lv_pos = lv_pos + 5.
          lv_start = lv_pos.
          CONTINUE.
        ENDIF.
      ENDIF.
      lv_pos = lv_pos + 1.
    ENDWHILE.
    lv_part = iv_where+lv_start.
    lv_part = condense( lv_part ).
    IF lv_part IS NOT INITIAL.
      APPEND lv_part TO rt_parts.
    ENDIF.
  ENDMETHOD.

  METHOD unquote.
    DATA lv_len TYPE i.
    rv_value = condense( iv_text ).
    lv_len = strlen( rv_value ).
    IF lv_len >= 2 AND rv_value(1) = `'`.
      lv_len = lv_len - 2.
      rv_value = rv_value+1(lv_len).
      REPLACE ALL OCCURRENCES OF `''` IN rv_value WITH `'`.
    ENDIF.
  ENDMETHOD.

  METHOD same.
* a number compares as a number ('01' is 1), anything else as text
    DATA lv_left  TYPE string.
    DATA lv_right TYPE string.
    DATA lv_a     TYPE i.
    DATA lv_b     TYPE i.

    lv_left = condense( iv_left ).
    lv_right = condense( iv_right ).
    IF lv_left CO '0123456789' AND lv_right CO '0123456789' AND lv_left IS NOT INITIAL AND lv_right IS NOT INITIAL
        AND strlen( lv_left ) < 10 AND strlen( lv_right ) < 10.
      lv_a = lv_left.
      lv_b = lv_right.
      rv_yes = boolc( lv_a = lv_b ).
    ELSE.
      rv_yes = boolc( lv_left = lv_right ).
    ENDIF.
  ENDMETHOD.

ENDCLASS.
