  METHOD next.
    " 16807 * x mod (2^31 - 1) by Schrage's method: no product leaves INT4
    DATA lv_hi TYPE i.
    DATA lv_lo TYPE i.
    lv_hi = iv_state DIV 127773.
    lv_lo = iv_state MOD 127773.
    rv_state = 16807 * lv_lo - 2836 * lv_hi.
    IF rv_state <= 0.
      rv_state = rv_state + c_modulus.
    ENDIF.
  ENDMETHOD.

  METHOD start.
    DATA lv_text TYPE string.
    DATA lv_len TYPE i.
    DATA lv_pos TYPE i.
    DATA lv_char TYPE c LENGTH 1.
    DATA lv_code TYPE i.
    DATA lv_room TYPE i.
    rv_state = iv_seed MOD c_modulus.
    IF rv_state <= 0.
      rv_state = 1.
    ENDIF.
    lv_text = iv_text.
    lv_len = strlen( lv_text ).
    DO lv_len TIMES.
      lv_pos = sy-index - 1.
      lv_char = lv_text+lv_pos(1).
      " a blank is no character of the alphabet (FIND would take it for nothing)
      lv_code = 0.
      IF lv_char <> space.
        FIND lv_char IN c_alphabet MATCH OFFSET lv_code.
        IF sy-subrc = 0.
          lv_code = lv_code + 1.
        ELSE.
          lv_code = 0.
        ENDIF.
      ENDIF.
      lv_room = c_modulus - lv_code.
      IF rv_state >= lv_room.
        rv_state = rv_state - lv_room.
      ELSE.
        rv_state = rv_state + lv_code.
      ENDIF.
      IF rv_state = 0.
        rv_state = 1.
      ENDIF.
      rv_state = next( rv_state ).
    ENDDO.
  ENDMETHOD.

  METHOD duration.
    " fixed, uniform, or the lognormal's quantile knots interpolated; every
    " product is packed and below 2^53
    DATA lt_at TYPE string_table.
    DATA lt_knots TYPE string_table.
    DATA lv_text TYPE string.
    DATA lv_count TYPE i.
    DATA lv_index TYPE i.
    DATA lv_prev TYPE i.
    DATA lv_p0 TYPE i.
    DATA lv_p1 TYPE i.
    DATA lv_k0 TYPE i.
    DATA lv_k1 TYPE i.
    DATA lv_span TYPE p LENGTH 16 DECIMALS 0.
    DATA lv_product TYPE p LENGTH 16 DECIMALS 0.
    CASE is_config-dist.
      WHEN 'U'.
        lv_span = is_config-dur_b - is_config-dur_a + 1.
        lv_product = lv_span * iv_u.
        lv_product = lv_product DIV c_million.
        rv_seconds = is_config-dur_a + lv_product.
      WHEN 'L'.
        SPLIT c_percentiles AT ` ` INTO TABLE lt_at.
        SPLIT is_config-knots AT ` ` INTO TABLE lt_knots.
        lv_count = lines( lt_at ).
        READ TABLE lt_at INDEX 1 INTO lv_text.
        lv_p0 = lv_text.
        IF iv_u <= lv_p0.
          READ TABLE lt_knots INDEX 1 INTO lv_text.
          rv_seconds = lv_text.
          RETURN.
        ENDIF.
        READ TABLE lt_at INDEX lv_count INTO lv_text.
        lv_p1 = lv_text.
        READ TABLE lt_knots INDEX lv_count INTO lv_text.
        rv_seconds = lv_text.
        IF iv_u >= lv_p1.
          RETURN.
        ENDIF.
        lv_index = 2.
        WHILE lv_index <= lv_count.
          READ TABLE lt_at INDEX lv_index INTO lv_text.
          lv_p1 = lv_text.
          IF iv_u < lv_p1.
            lv_prev = lv_index - 1.
            READ TABLE lt_at INDEX lv_prev INTO lv_text.
            lv_p0 = lv_text.
            READ TABLE lt_knots INDEX lv_prev INTO lv_text.
            lv_k0 = lv_text.
            READ TABLE lt_knots INDEX lv_index INTO lv_text.
            lv_k1 = lv_text.
            lv_span = lv_k1 - lv_k0.
            lv_product = lv_span * ( iv_u - lv_p0 ).
            lv_product = lv_product DIV ( lv_p1 - lv_p0 ).
            rv_seconds = lv_k0 + lv_product.
            RETURN.
          ENDIF.
          lv_index = lv_index + 1.
        ENDWHILE.
      WHEN OTHERS.
        rv_seconds = is_config-dur_a.
    ENDCASE.
  ENDMETHOD.

  METHOD hits.
    " fixed, uniform, or the Poisson's table P(K <= k) in millionths
    DATA lt_cdf TYPE string_table.
    DATA lv_text TYPE string.
    DATA lv_bound TYPE i.
    DATA lv_span TYPE p LENGTH 16 DECIMALS 0.
    DATA lv_product TYPE p LENGTH 16 DECIMALS 0.
    CASE is_config-hits.
      WHEN 'U'.
        lv_span = is_config-hits_b - is_config-hits_a + 1.
        lv_product = lv_span * iv_u.
        lv_product = lv_product DIV c_million.
        rv_hits = is_config-hits_a + lv_product.
      WHEN 'P'.
        SPLIT is_config-cdf AT ` ` INTO TABLE lt_cdf.
        rv_hits = lines( lt_cdf ) - 1.
        LOOP AT lt_cdf INTO lv_text.
          lv_bound = lv_text.
          IF iv_u < lv_bound.
            rv_hits = sy-tabix - 1.
            RETURN.
          ENDIF.
        ENDLOOP.
      WHEN OTHERS.
        rv_hits = is_config-hits_a.
    ENDCASE.
  ENDMETHOD.

  METHOD draw.
    " the order of the draws is the twin's: outcome, duration, hits, keys
    DATA ls_config TYPE ty_config.
    DATA lv_text TYPE string.
    DATA lv_run TYPE string.
    DATA lv_rule TYPE string.
    DATA lv_state TYPE i.
    DATA lv_u TYPE i.
    DATA lv_base TYPE i.
    DATA lv_bound TYPE i.
    DATA lt_pool TYPE string_table.
    DATA lv_key TYPE string.
    DATA lv_other TYPE string.
    DATA lv_k TYPE i.
    DATA lv_n TYPE i.
    DATA lv_i TYPE i.
    DATA lv_j TYPE i.
    DATA lv_span TYPE p LENGTH 16 DECIMALS 0.
    DATA lv_product TYPE p LENGTH 16 DECIMALS 0.
    ls_config = config( is_pile-rule ).
    lv_run = is_pile-run_id.
    lv_rule = is_pile-rule.
    lv_text = |{ lv_run }\|{ lv_rule }\|{ is_pile-pile_no }\|{ is_pile-attempt }|.
    lv_state = start( iv_seed = is_pile-seed
                      iv_text = lv_text ).
    lv_state = next( lv_state ).
    lv_u = lv_state MOD c_million.
    lv_bound = ls_config-ok.
    IF lv_u < lv_bound.
      rs_draw-outcome = 'OK'.
    ELSE.
      lv_bound = lv_bound + ls_config-slow.
      IF lv_u < lv_bound.
        rs_draw-outcome = 'SLOW'.
      ELSE.
        lv_bound = lv_bound + ls_config-dump.
        IF lv_u < lv_bound.
          rs_draw-outcome = 'DUMP'.
        ELSE.
          rs_draw-outcome = 'HANG'.
        ENDIF.
      ENDIF.
    ENDIF.
    lv_state = next( lv_state ).
    lv_u = lv_state MOD c_million.
    lv_base = duration( is_config = ls_config
                        iv_u = lv_u ).
    lv_state = next( lv_state ).
    lv_u = lv_state MOD c_million.
    rs_draw-hits = hits( is_config = ls_config
                         iv_u = lv_u ).
    IF iv_filter = abap_true.
      " a filter keeps each key with the probability keep
      LOOP AT it_keys INTO lv_key.
        lv_state = next( lv_state ).
        lv_u = lv_state MOD c_million.
        IF lv_u < ls_config-keep.
          APPEND lv_key TO rs_draw-keys.
        ENDIF.
      ENDLOOP.
    ELSE.
      " a check hits min( hits, keys ) distinct keys: a partial Fisher-Yates
      lt_pool = it_keys.
      lv_n = lines( lt_pool ).
      lv_k = rs_draw-hits.
      IF lv_k > lv_n.
        lv_k = lv_n.
      ENDIF.
      lv_i = 1.
      WHILE lv_i <= lv_k.
        lv_span = lv_n - lv_i + 1.
        lv_state = next( lv_state ).
        lv_u = lv_state MOD c_million.
        lv_product = lv_span * lv_u.
        lv_product = lv_product DIV c_million.
        lv_j = lv_i + lv_product.
        READ TABLE lt_pool INDEX lv_i INTO lv_key.
        READ TABLE lt_pool INDEX lv_j INTO lv_other.
        MODIFY lt_pool FROM lv_other INDEX lv_i.
        MODIFY lt_pool FROM lv_key INDEX lv_j.
        APPEND lv_other TO rs_draw-keys.
        lv_i = lv_i + 1.
      ENDWHILE.
      SORT rs_draw-keys.
    ENDIF.
    " the simulated seconds: slow takes slow_factor times as long, a dump
    " half, a hang half as long again as stale; then the wall wait, rounded
    lv_product = lv_base.
    CASE rs_draw-outcome.
      WHEN 'SLOW'.
        lv_product = lv_product * ls_config-slow_factor.
      WHEN 'DUMP'.
        lv_product = lv_base DIV 2.
      WHEN 'HANG'.
        lv_product = is_pile-stale DIV 2.
        lv_product = lv_product + is_pile-stale.
    ENDCASE.
    IF lv_product > c_modulus.
      lv_product = c_modulus.
    ENDIF.
    rs_draw-duration = lv_product.
    lv_product = lv_product * is_pile-scale.
    lv_product = lv_product + 500000.
    lv_product = lv_product DIV c_million.
    rs_draw-wait = lv_product.
  ENDMETHOD.

  METHOD alert.
    " SIM, the rule's literal prefix, the key padded to its width (so the
    " governor reads it four characters further on), the pile and attempt
    DATA lv_key TYPE string.
    lv_key = iv_key.
    WHILE strlen( lv_key ) < is_config-key_length.
      lv_key = lv_key && ` `.
    ENDWHILE.
    rv_text = |SIM { is_config-prefix }{ lv_key }: simulated hit, pile { is_pile-pile_no }, attempt { is_pile-attempt }|.
  ENDMETHOD.

  METHOD act.
    " the work is done for real: the wait, then a normal end or an abnormal one
    DATA ls_audit TYPE zosd_l3_doctor.
    DATA lv_hits TYPE i.
    ls_audit-mandt = sy-mandt.
    ls_audit-run_id = is_pile-run_id.
    ls_audit-set_name = 'fleet2'.
    ls_audit-rule_name = is_pile-rule.
    ls_audit-pile_no = is_pile-pile_no.
    SELECT SINGLE check_date stage_no FROM zosd_l3_pile
      INTO (ls_audit-check_date, ls_audit-stage_no)
      WHERE run_id = is_pile-run_id
        AND rule_name = is_pile-rule
        AND pile_no = is_pile-pile_no.
    ls_audit-doc_action = 'WORK'.
    lv_hits = lines( is_draw-keys ).
    ls_audit-reason = |{ is_draw-outcome } { is_draw-wait } { lv_hits }|.
    GET TIME STAMP FIELD ls_audit-acted.
    " negative audit keys keep simultaneous work apart from doctor actions
    SELECT MIN( seq ) FROM zosd_l3_doctor INTO ls_audit-seq
      WHERE run_id = is_pile-run_id.
    DO.
      ls_audit-seq = ls_audit-seq - 1.
      INSERT zosd_l3_doctor FROM ls_audit.
      IF sy-subrc = 0.
        EXIT.
      ENDIF.
    ENDDO.
    WAIT UP TO is_draw-wait SECONDS.
    IF is_draw-outcome = 'DUMP' OR is_draw-outcome = 'HANG'.
      RAISE EXCEPTION TYPE zcx_l3_fleet2_port
        EXPORTING iv_port = 'work'
                  iv_variant = 'sim'
                  iv_reason = 'SIM: the simulated work ends abnormally, as a dump does'.
    ENDIF.
  ENDMETHOD.

  METHOD zif_l3_fleet2_work~check.
    DATA ls_draw TYPE ty_draw.
    DATA ls_config TYPE ty_config.
    DATA lv_key TYPE string.
    DATA lv_text TYPE string.
    ls_draw = draw( is_pile = is_pile
                    it_keys = it_keys ).
    act( is_draw = ls_draw is_pile = is_pile ).
    ls_config = config( is_pile-rule ).
    LOOP AT ls_draw-keys INTO lv_key.
      lv_text = alert( is_pile = is_pile
                       is_config = ls_config
                       iv_key = lv_key ).
      APPEND lv_text TO rt_alerts.
    ENDLOOP.
  ENDMETHOD.

  METHOD zif_l3_fleet2_work~keys.
    DATA ls_draw TYPE ty_draw.
    ls_draw = draw( is_pile = is_pile
                    it_keys = it_keys
                    iv_filter = abap_true ).
    act( is_draw = ls_draw is_pile = is_pile ).
    rt_keys = ls_draw-keys.
  ENDMETHOD.
ENDCLASS.
