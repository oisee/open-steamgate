  METHOD check_reference.
    " the rule as a person would write it: a SELECT on the exists table for
    " every row of the first
    DATA lt_ship TYPE STANDARD TABLE OF zosd_l2_ship WITH DEFAULT KEY.
    DATA ls_ship TYPE zosd_l2_ship.
    DATA lt_aggregate_values TYPE STANDARD TABLE OF zosd_l2_cargo-weight WITH DEFAULT KEY.
    DATA lv_aggregate_value TYPE zosd_l2_cargo-weight.
    DATA lv_alert TYPE string.
    DATA lv_aggregate TYPE p LENGTH 16 DECIMALS 2.
    DATA lv_aggregate_text TYPE string.
    DATA lv_aggregate_signed TYPE string.
    DATA lv_aggregate_abs TYPE p LENGTH 16 DECIMALS 2.
    DATA lv_aggregate_seen TYPE c LENGTH 1.
    SELECT * FROM zosd_l2_ship INTO TABLE lt_ship
      WHERE ship_id IN it_range
      ORDER BY PRIMARY KEY.
    LOOP AT lt_ship INTO ls_ship.
      SELECT weight FROM zosd_l2_cargo INTO TABLE lt_aggregate_values
        WHERE ship_id = ls_ship-ship_id
        ORDER BY PRIMARY KEY.
      CLEAR lv_aggregate.
      CLEAR lv_aggregate_seen.
      LOOP AT lt_aggregate_values INTO lv_aggregate_value.
        ADD lv_aggregate_value TO lv_aggregate.
        lv_aggregate_seen = 'X'.
      ENDLOOP.
      IF lv_aggregate > '1000.00'.
        lv_aggregate_abs = lv_aggregate.
        IF lv_aggregate < 0.
          lv_aggregate_abs = 0 - lv_aggregate.
        ENDIF.
        lv_aggregate_text = lv_aggregate_abs.
        CONDENSE lv_aggregate_text NO-GAPS.
        IF lv_aggregate < 0.
          CONCATENATE `-` lv_aggregate_text INTO lv_aggregate_signed.
          lv_aggregate_text = lv_aggregate_signed.
        ENDIF.
        lv_alert = ls_ship-ship_id
          && `: `
          && lv_aggregate_text
          && ` kg booked`.
        APPEND lv_alert TO rt_alerts.
      ENDIF.
    ENDLOOP.
