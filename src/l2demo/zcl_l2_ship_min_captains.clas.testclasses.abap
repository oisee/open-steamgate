    DATA lv_alert TYPE string.
    DATA lv_count TYPE i.
    DATA lv_count_text TYPE c LENGTH 12.
    SELECT * FROM zosd_l2_ship INTO TABLE lt_ship
      WHERE status = 'A'
      ORDER BY PRIMARY KEY.
    LOOP AT lt_ship INTO ls_ship.
      SELECT * FROM zosd_l2_crew INTO TABLE lt_crew
        WHERE ship_id = ls_ship-ship_id
          AND role = 'C'
        ORDER BY PRIMARY KEY.
      DESCRIBE TABLE lt_crew LINES lv_count.
      IF lv_count < 2.
        lv_count_text = lv_count.
        CONDENSE lv_count_text NO-GAPS.
        lv_alert = ls_ship-ship_id
          && ` `
          && ls_ship-name
          && `: `
          && lv_count_text
