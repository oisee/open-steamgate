"! CRC-32 (the zip and gzip checksum, reflected polynomial EDB88320) over
"! data that arrives in pieces: UPDATE with each piece, VALUE at the end.
"! Byte operations only (BIT-XOR on x fields and a table of the 256 values),
"! so it runs the same on a system, on Node and on Go.
CLASS zcl_osd_crc32 DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    TYPES ty_crc TYPE x LENGTH 4.
    CLASS-METHODS class_constructor.
    CLASS-METHODS of
      IMPORTING iv_data       TYPE xstring
      RETURNING VALUE(rv_crc) TYPE ty_crc.
    METHODS constructor.
    METHODS update
      IMPORTING iv_data TYPE xstring.
    "! The checksum as a number, most significant byte first
    METHODS value
      RETURNING VALUE(rv_crc) TYPE ty_crc.
  PRIVATE SECTION.
    CLASS-DATA gt_table TYPE STANDARD TABLE OF ty_crc WITH DEFAULT KEY.
    DATA mv_crc TYPE x LENGTH 4.
ENDCLASS.


CLASS zcl_osd_crc32 IMPLEMENTATION.

  METHOD class_constructor.
    DATA lv_text TYPE string.
    DATA lv_hex TYPE xstring.
    DATA lv_entry TYPE ty_crc.
    DATA lv_off TYPE i.
    CONCATENATE
      '0000000077073096EE0E612C990951BA076DC419706AF48FE963A5359E6495A30EDB883279DCB8A4E0D5E91E97D2D98809B64C2B7EB17CBDE7B82D0790BF1D911DB710646AB020F2F3B9714884BE41DE1ADAD47D6DDDE4EBF4D4B55183D385C7'
      '136C9856646BA8C0FD62F97A8A65C9EC14015C4F63066CD9FA0F3D638D080DF53B6E20C84C69105ED56041E4A26771723C03E4D14B04D447D20D85FDA50AB56B35B5A8FA42B2986CDBBBC9D6ACBCF94032D86CE345DF5C75DCD60DCFABD13D59'
      '26D930AC51DE003AC8D75180BFD0611621B4F4B556B3C423CFBA9599B8BDA50F2802B89E5F058808C60CD9B2B10BE9242F6F7C8758684C11C1611DABB6662D3D76DC419001DB710698D220BCEFD5102A71B1858906B6B51F9FBFE4A5E8B8D433'
      '7807C9A20F00F9349609A88EE10E98187F6A0DBB086D3D2D91646C97E6635C016B6B51F41C6C6162856530D8F262004E6C0695ED1B01A57B8208F4C1F50FC45765B0D9C612B7E9508BBEB8EAFCB9887C62DD1DDF15DA2D498CD37CF3FBD44C65'
      '4DB261583AB551CEA3BC0074D4BB30E24ADFA5413DD895D7A4D1C46DD3D6F4FB4369E96A346ED9FCAD678846DA60B8D044042D7333031DE5AA0A4C5FDD0D7CC95005713C270241AABE0B1010C90C20865768B525206F85B3B966D409CE61E49F'
      '5EDEF90E29D9C998B0D09822C7D7A8B459B33D172EB40D81B7BD5C3BC0BA6CADEDB883209ABFB3B603B6E20C74B1D29AEAD547399DD277AF04DB261573DC1683E3630B1294643B840D6D6A3E7A6A5AA8E40ECF0B9309FF9D0A00AE277D079EB1'
      'F00F93448708A3D21E01F2686906C2FEF762575D806567CB196C36716E6B06E7FED41B7689D32BE010DA7A5A67DD4ACCF9B9DF6F8EBEEFF917B7BE4360B08ED5D6D6A3E8A1D1937E38D8C2C44FDFF252D1BB67F1A6BC57673FB506DD48B2364B'
      'D80D2BDAAF0A1B4C36034AF641047A60DF60EFC3A867DF55316E8EEF4669BE79CB61B38CBC66831A256FD2A05268E236CC0C7795BB0B4703220216B95505262FC5BA3BBEB2BD0B282BB45A925CB36A04C2D7FFA7B5D0CF312CD99E8B5BDEAE1D'
      '9B64C2B0EC63F226756AA39C026D930A9C0906A9EB0E363F720767850500571395BF4A82E2B87A147BB12BAE0CB61B3892D28E9BE5D5BE0D7CDCEFB70BDBDF2186D3D2D4F1D4E24268DDB3F81FDA836E81BE16CDF6B9265B6FB077E118B74777'
      '88085AE6FF0F6A7066063BCA11010B5C8F659EFFF862AE69616BFFD3166CCF45A00AE278D70DD2EE4E0483543903B3C2A7672661D06016F74969474D3E6E77DBAED16A4AD9D65ADC40DF0B6637D83BF0A9BCAE53DEBB9EC547B2CF7F30B5FFE9'
      'BDBDF21CCABAC28A53B3933024B4A3A6BAD03605CDD7069354DE572923D967BFB3667A2EC4614AB85D681B022A6F2B94B40BBE37C30C8EA15A05DF1B2D02EF8D'
      INTO lv_text.
    lv_hex = lv_text.
    DO 256 TIMES.
      lv_entry = lv_hex+lv_off(4).
      APPEND lv_entry TO gt_table.
      lv_off = lv_off + 4.
    ENDDO.
  ENDMETHOD.

  METHOD constructor.
    mv_crc = 'FFFFFFFF'.
  ENDMETHOD.

  METHOD of.
    DATA lo_crc TYPE REF TO zcl_osd_crc32.
    CREATE OBJECT lo_crc.
    lo_crc->update( iv_data ).
    rv_crc = lo_crc->value( ).
  ENDMETHOD.

  METHOD update.
    DATA lv_crc TYPE ty_crc.
    DATA lv_byte TYPE x LENGTH 1.
    DATA lv_low TYPE x LENGTH 1.
    DATA lv_zero TYPE x LENGTH 1.
    DATA lv_index TYPE i.
    DATA lv_shift TYPE xstring.
    DATA lv_entry TYPE ty_crc.
    DATA lv_pos TYPE i.
    DATA lv_len TYPE i.
    lv_crc = mv_crc.
    lv_len = xstrlen( iv_data ).
    WHILE lv_pos < lv_len.
      lv_byte = iv_data+lv_pos(1).
      lv_low = lv_crc+3(1).
      lv_low = lv_low BIT-XOR lv_byte.
      lv_index = lv_low.
      READ TABLE gt_table INDEX lv_index + 1 INTO lv_entry.
      " the checksum shifted right by one byte
      CONCATENATE lv_zero lv_crc(3) INTO lv_shift IN BYTE MODE.
      lv_crc = lv_shift.
      lv_crc = lv_crc BIT-XOR lv_entry.
      lv_pos = lv_pos + 1.
    ENDWHILE.
    mv_crc = lv_crc.
  ENDMETHOD.

  METHOD value.
    DATA lv_ones TYPE ty_crc VALUE 'FFFFFFFF'.
    DATA lv_crc TYPE ty_crc.
    lv_crc = mv_crc.
    rv_crc = lv_crc BIT-XOR lv_ones.
  ENDMETHOD.

ENDCLASS.
