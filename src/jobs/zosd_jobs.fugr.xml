      <RSIMP><PARAMETER>JOBNAME</PARAMETER><TYP>STRING</TYP></RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP><PARAMETER>JOBCOUNT</PARAMETER><TYP>STRING</TYP></RSEXP>
