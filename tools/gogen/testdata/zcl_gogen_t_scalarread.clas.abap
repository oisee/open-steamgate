CLASS zcl_gogen_t_scalarread DEFINITION PUBLIC FINAL CREATE PUBLIC.
  PUBLIC SECTION.
    CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
  PRIVATE SECTION.
    TYPES ty_tab TYPE STANDARD TABLE OF i WITH DEFAULT KEY.
ENDCLASS.

CLASS zcl_gogen_t_scalarread IMPLEMENTATION.
  METHOD run.
    DATA lt TYPE ty_tab.
    DATA v TYPE i.
    FIELD-SYMBOLS <row> TYPE i.
    v = 1. APPEND v TO lt.
    v = 2. APPEND v TO lt.
    READ TABLE lt INDEX 2 ASSIGNING <row>.
    DELETE lt INDEX 1.
    <row> = 9.
    READ TABLE lt INDEX 1 INTO v.
    rv = |{ v }|.
  ENDMETHOD.
ENDCLASS.
