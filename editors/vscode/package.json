{
  "name": "osd-vscode",
  "displayName": "open-steamgate (osd)",
  "description": "ABAP Unit in the Test Explorer, the serving generation and short dumps of a running osd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "open-steamgate",
  "engines": {"vscode": "^1.88.0"},
  "categories": ["Testing", "Other"],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.abap",
    "onNotebook:osd-sql-notebook",
    "onCommand:osd.newSqlNotebook"
  ],
  "contributes": {
    "configuration": {
      "title": "osd",
      "properties": {
        "osd.url": {
          "type": "string",
          "default": "http://localhost:3030",
          "description": "The listener of a running osd (npm start, build/osd up)."
        },
        "osd.keymap": {
          "type": "string",
          "enum": ["abap", "vscode"],
          "default": "abap",
          "description": "What an ABAP developer's fingers expect (SAP GUI / ADT: Ctrl+F2 Check, Ctrl+F3 Activate, F8 Run, the debug keys) over an .abap editor, or VS Code's own bindings unchanged (\"vscode\")."
        },
        "osd.notebook.rowLimit": {
          "type": "number",
          "default": 100,
          "description": "The row limit (rowNumber) a *.osdnb cell's SELECT is run with, against /sap/bc/adt/datapreview/freestyle."
        }
      }
    },
    "notebooks": [
      {
        "type": "osd-sql-notebook",
        "displayName": "osd SQL Notebook",
        "selector": [{"filenamePattern": "*.osdnb"}]
      }
    ],
    "commands": [
      {"command": "osd.showDumps", "title": "osd: Show short dumps"},
      {"command": "osd.check", "title": "osd: Check"},
      {"command": "osd.activate", "title": "osd: Activate"},
      {"command": "osd.run", "title": "osd: Run"},
      {"command": "osd.newSqlNotebook", "title": "osd: New SQL notebook"}
    ],
    "keybindings": [
      {"key": "ctrl+f2", "command": "osd.check", "when": "resourceExtname == .abap && config.osd.keymap == abap"},
      {"key": "ctrl+f3", "command": "osd.activate", "when": "resourceExtname == .abap && config.osd.keymap == abap"},
      {"key": "f8", "command": "osd.run", "when": "resourceExtname == .abap && config.osd.keymap == abap && !inDebugMode"},
      {"key": "ctrl+shift+f10", "command": "testing.runCurrentFile", "when": "resourceExtname == .abap && config.osd.keymap == abap"},

      {"key": "ctrl+shift+b", "command": "editor.debug.action.toggleBreakpoint", "when": "resourceExtname == .abap && config.osd.keymap == abap"},
      {"key": "f5", "command": "workbench.action.debug.stepInto", "when": "resourceExtname == .abap && config.osd.keymap == abap && inDebugMode"},
      {"key": "f6", "command": "workbench.action.debug.stepOver", "when": "resourceExtname == .abap && config.osd.keymap == abap && inDebugMode"},
      {"key": "f7", "command": "workbench.action.debug.stepOut", "when": "resourceExtname == .abap && config.osd.keymap == abap && inDebugMode"},
      {"key": "f8", "command": "workbench.action.debug.continue", "when": "resourceExtname == .abap && config.osd.keymap == abap && inDebugMode"}
    ]
  }
}
