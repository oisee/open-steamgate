# Local, never committed
.local/
.env
cookies.txt
.mcp.json

# Captures carry real logons / session GUIDs / credentials — never commit
*.pcap
*.jsonl
captures/

# Node / transpiler substrate
# without the trailing slash as well: in an OSD worktree this is a symlink
# to the checkout's own, and a rule ending in / matches directories only, so
# the shared dependencies showed up as an untracked file on that branch
node_modules/
node_modules
# `/output` and not `output/`: the build makes it a DIRECTORY on one host and
# a SYMLINK into build/live/ on another, and a rule ending in a slash matches
# only the directory. So the symlink sat untracked all day and `git add -A`
# would have committed a link into an untracked build folder.
/output
deps/
dist/
build/
*.sqlite
*.db
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Playwright
test-results/
playwright-report/

# generated from src/cds by tools/cds2ddic.mjs
gen/

# generated by scripts/build-preview.mjs
web/generated/
.segw-cloud.abaplint.json

# the cross-reference tables of OSD are derived from the parse, not authored:
# npm run osd:xref -- --write regenerates them (tools/osd-xref.mjs)
data/cross.tabu.json
data/wbcrossgt.tabu.json
data/wbcrossgtx.tabu.json
data/d010inc.tabu.json

# objects brought into the local system from a repository (npm run osd:import)
local/

# what a pack fetches rather than carries (tools/osd-fetch.mjs): the folder
# named upstream/ by convention, and the marker saying which commit it holds
packs/*/upstream/
packs/*/games/
packs/*/.osd-fetched.json
